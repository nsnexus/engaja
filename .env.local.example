# .env.local.example
# Copie este arquivo para .env.local e preencha com suas credenciais

# Firebase Client SDK (seguro expor com NEXT_PUBLIC)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (NUNCA expor com NEXT_PUBLIC)
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PROJECT_ID=

# Efí Bank (Gerencianet) — Pagamentos Pix
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_ENV=sandbox # 'sandbox' para testes ou 'production' para produção
EFI_PROXY_URL= # Opcional: URL do Cloudflare Worker Proxy de mTLS
EFI_PROXY_SECRET= # Opcional: Segredo do Worker Proxy
EFI_WEBHOOK_SECRET= # Segredo configurado na URL do Webhook da Efí

# MachinesSMM API
MACHINESMM_API_KEY=054b04e9d3765c1c78c6b7ee01421544
MACHINESMM_API_URL=https://machinesmm.com/api/v2
